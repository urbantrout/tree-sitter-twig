{
  "grammars": [
    {
      "name": "twig",
      "camelcase": "Twig",
      "scope": "source.twig",
      "path": ".",
      "external-files": [
        "src/tag.h"
      ],
      "file-types": [
        "twig"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "twig"
    }
  ],
  "metadata": {
    "version": "0.23.2",
    "license": "MIT",
    "description": "Twig grammar for tree-sitter",
    "authors": [
      {
        "name": "Harald Atteneder",
        "email": "harald@urbantrout.io"
      }
    ],
    "links": {
      "repository": "https://github.com/urbantrout/tree-sitter-twig"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
